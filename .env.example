# Copy to .env.local. Nothing here is a secret: the browser never talks to the Go API directly.

# Where the Next.js server forwards /api/v1/* (the Go API)
API_INTERNAL_URL=http://localhost:8080

# Your LiveKit Cloud host, allowed in the Content-Security-Policy (no wss://).
# Read at runtime, so it can be set as a normal secret/env on the host.
LIVEKIT_HOST=your-project.livekit.cloud
